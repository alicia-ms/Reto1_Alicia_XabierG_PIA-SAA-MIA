# Copiad este archivo como .env (con el punto delante) y rellenadlo.
# El archivo .env NO se sube a GitHub: lo impide el .gitignore.
# Este archivo (.env.example) SÍ se sube: solo tiene valores falsos.

# Dirección del Webhook (Production URL del nodo Webhook de n8n)
N8N_URL=http://localhost:5678/webhook/empresa/decision

# El Name de vuestra credencial Header Auth en n8n (escrito exactamente igual)
N8N_CABECERA=X-Api-Key


# El Value de vuestra credencial Header Auth en n8n
N8N_CLAVE=e9a4e4374a7b683d7ae06b375fa232b5


